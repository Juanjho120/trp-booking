# TRP Booking environment template.
# Copy this file to `.env` for local Prisma CLI usage and server-side env validation.
# Copy the required values to Vercel environment variables when deploying.
#
# Do not commit `.env`, `.env.local`, or any real secret values.

# Application environment
#
# TRP_ENVIRONMENT is the business/runtime environment source of truth.
# Do not infer it from VERCEL_ENV: the stable test deployment uses a Vercel
# production deployment while remaining TRP_ENVIRONMENT=test.
#
# local      -> localhost, Tilopay sandbox, email disabled or test
# test       -> https://trp-booking.juantzun.dev, Tilopay sandbox, email disabled or test
# production -> https://turefugioperfecto.com, Tilopay production, email disabled or production
TRP_ENVIRONMENT="local"

# Supabase / PostgreSQL
#
# Development target:
# - Supabase organization/project: portfolio-lab
# - PostgreSQL schema: trp_booking
#
# Use the pooled connection for runtime usage when available.
# Use the direct connection for Prisma migrations when available.
#
# Keep `schema=trp_booking` in both URLs so Prisma does not use the public schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=trp_booking"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=trp_booking"

# Auth.js / NextAuth
#
# Generate AUTH_SECRET locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Local development should use AUTH_TRUST_HOST=true once Auth.js routes and admin middleware are enabled.
# Vercel deployments should also use AUTH_TRUST_HOST=true unless explicitly verified otherwise.
#
# AUTH_ALLOWED_ADMIN_EMAILS must be a comma-separated server-side allowlist.
AUTH_SECRET="CHANGE_ME_GENERATE_RANDOM_SECRET"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="CHANGE_ME_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="CHANGE_ME_GOOGLE_SECRET"
AUTH_ALLOWED_ADMIN_EMAILS="admin@mail.trp-booking.juantzun.dev"

# Optional for local development or non-standard deployments.
# Auth.js v5 usually infers the host from request headers when trusted host is enabled.
# AUTH_URL="http://localhost:3000"

# Cloudinary
#
# Phase 5.2 validates these server-side.
# Add real values to `.env` before running `npm run env:validate`.
#
# Keep these values server-side only. Do not expose the API key or API secret through NEXT_PUBLIC variables.
# Use a dedicated development folder so test assets do not mix with production assets.
CLOUDINARY_CLOUD_NAME="CHANGE_ME_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="CHANGE_ME_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="CHANGE_ME_CLOUDINARY_API_SECRET"
CLOUDINARY_UPLOAD_FOLDER="trp-booking/dev"

# Tilopay
#
# These names map directly to the values shown in the Tilopay admin panel:
# - Api Key      -> TILOPAY_API_KEY
# - Api User     -> TILOPAY_API_USER
# - Api Password -> TILOPAY_API_PASSWORD
#
# Keep all Tilopay values server-side only. Do not expose them through NEXT_PUBLIC variables.
# Do not commit real Tilopay credentials, tokens, signatures, or provider payloads.
#
# local/test must use sandbox. production must use production.
# Local callback URLs may use localhost. Test and production URLs must use their approved HTTPS domains.
TILOPAY_ENVIRONMENT="sandbox"
TILOPAY_API_KEY="CHANGE_ME_TILOPAY_API_KEY"
TILOPAY_API_USER="CHANGE_ME_TILOPAY_API_USER"
TILOPAY_API_PASSWORD="CHANGE_ME_TILOPAY_API_PASSWORD"
TILOPAY_REDIRECT_URL="http://localhost:3000/api/payments/tilopay/redirect"
TILOPAY_SUCCESS_URL="http://localhost:3000/reservas/pago/exitoso"
TILOPAY_CANCEL_URL="http://localhost:3000/reservas/pago/cancelado"
TILOPAY_ERROR_URL="http://localhost:3000/reservas/pago/error"
TILOPAY_WEBHOOK_URL="http://localhost:3000/api/payments/tilopay/webhook"

# Resend / transactional email
#
# Keep EMAIL_DELIVERY_MODE=disabled until the matching Resend API key and verified sending domain are ready.
# Local guest delivery uses EMAIL_TEST_RECIPIENT as a safety override.
# Local admin delivery still goes to EMAIL_ADMIN_RECIPIENTS.
# Stable test delivery uses the intended guest/admin recipient directly.
# Keep all values server-side only. Never use NEXT_PUBLIC variables for email configuration.
#
# Local/test Resend account and verified sending domain:
# - personal test account
# - mail.trp-booking.juantzun.dev
#
# Human replies for local/test are routed to the separate Zoho Mail mailbox on juantzun.dev.
# Resend continues to own automatic delivery from the mail.trp-booking.juantzun.dev subdomain.
#
# Future production Resend account and verified sending domain:
# - Tu Refugio Perfecto company account
# - mail.turefugioperfecto.com
# Human production replies route to the separate Zoho Mail organization on turefugioperfecto.com.
EMAIL_DELIVERY_MODE="disabled"
RESEND_API_KEY=""
EMAIL_FROM_ES="Tu Refugio Perfecto Test <reservas@mail.trp-booking.juantzun.dev>"
EMAIL_FROM_EN="Tu Refugio Perfecto Test <reservations@mail.trp-booking.juantzun.dev>"
EMAIL_REPLY_TO_ES="reservas@juantzun.dev"
EMAIL_REPLY_TO_EN="reservations@juantzun.dev"
EMAIL_ADMIN_RECIPIENTS="admin@juantzun.dev"
EMAIL_ADMIN_LOCALE="es"
EMAIL_PUBLIC_BASE_URL="http://localhost:3000"
# Must be a permanent, publicly reachable HTTPS asset URL (for example, Cloudinary).
EMAIL_BRAND_LOGO_URL="https://res.cloudinary.com/juan-tzun-portfolio/image/upload/v1784668172/trp-booking/brand/logo-primary.png"
# Required only when TRP_ENVIRONMENT=local and EMAIL_DELIVERY_MODE=test.
# Set this to a personal mailbox you control for local guest-email testing.
EMAIL_TEST_RECIPIENT=""

# Public WhatsApp contact (Final-F.R4)
#
# This number is public by design; it is NOT a secret.
# Local/Test should use the developer/test WhatsApp Business App number.
# Production should use Tu Refugio Perfecto's official WhatsApp Business App number.
# Values may differ by environment and must be formatted as +<E.164>.
# Vercel changes require redeployment because NEXT_PUBLIC values are build-time public config.
# Leave empty until the public number is configured; the floating action will not render.
NEXT_PUBLIC_WHATSAPP_PHONE_E164=""

# Android Admin Web Push / VAPID (Final-F.R5)
#
# Standard Web Push uses one stable VAPID keypair per environment.
# Generate the Developer/Test pair after installing dependencies with:
# npx web-push generate-vapid-keys
#
# WEB_PUSH_VAPID_PUBLIC_KEY is public key material but is kept in server config
# and revealed only to authenticated ADMIN browsers through the protected config API.
# WEB_PUSH_VAPID_PRIVATE_KEY is a server-side secret. Never paste it into git,
# docs, logs, browser code, test fixtures, or final reports.
# WEB_PUSH_SUBJECT must be mailto:<valid email> or https://<public URL>.
#
# All three empty -> Web Push unavailable/disabled safely.
# All three valid -> Web Push enabled.
# Partial configuration is invalid.
#
# Developer/Test should use developer-owned VAPID key material.
# Future Production belongs to Phase 13 and must use company-owned key material.
# Do not rotate an environment keypair casually after real subscriptions exist.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""

# Zoho Mail incoming-email webhook (Final-F.7)
#
# TRP stores only bounded Limited Data List metadata from Zoho Mail outgoing
# webhooks: subject, from, to and received/sent time. Zoho Mail remains the
# human mailbox and owns email bodies, threads, replies, attachments, search,
# spam handling, retention and mobile mailbox UX.
#
# Generate the server-side AES-256-GCM key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Generate the temporary bootstrap token with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# All values must stay server-side only. Never expose them through NEXT_PUBLIC
# variables, logs, database records, API responses, service worker payloads or
# final reports.
# ZOHO_MAIL_WEBHOOK_BOOTSTRAP_TOKEN is required only for the first Zoho webhook
# registration request in each environment. During first registration only, put
# the temporary token in the Zoho outgoing-webhook callback URL as:
# https://trp-booking.juantzun.dev/api/integrations/zoho-mail/webhook?bootstrap=<temporary-token>
# Treat that temporary callback URL as a credential. After the first Zoho POST
# returns HTTP 200 and the encrypted x-hook-secret is persisted, edit the Zoho
# outgoing webhook callback URL to remove the query string:
# https://trp-booking.juantzun.dev/api/integrations/zoho-mail/webhook
# Save the clean URL first; then remove ZOHO_MAIL_WEBHOOK_BOOTSTRAP_TOKEN from
# Vercel Test and redeploy. The persisted encrypted x-hook-secret remains
# authoritative for normal requests.
ZOHO_MAIL_WEBHOOK_ENCRYPTION_KEY=""
ZOHO_MAIL_WEBHOOK_BOOTSTRAP_TOKEN=""

# Stable test deployment values:
# TRP_ENVIRONMENT="test"
# EMAIL_DELIVERY_MODE="test"
# EMAIL_REPLY_TO_ES="reservas@juantzun.dev"
# EMAIL_REPLY_TO_EN="reservations@juantzun.dev"
# EMAIL_ADMIN_RECIPIENTS="admin@juantzun.dev"
# EMAIL_TEST_RECIPIENT=""
# EMAIL_PUBLIC_BASE_URL="https://trp-booking.juantzun.dev"
# EMAIL_BRAND_LOGO_URL="https://res.cloudinary.com/juan-tzun-portfolio/image/upload/v1784668172/trp-booking/brand/logo-primary.png"
# Guest transactional emails are delivered to the address entered on the reservation.
# Administrative emails remain centralized in the juantzun.dev Zoho mailbox.
# TILOPAY_ENVIRONMENT="sandbox"
# TILOPAY_REDIRECT_URL="https://trp-booking.juantzun.dev/api/payments/tilopay/redirect"
# TILOPAY_SUCCESS_URL="https://trp-booking.juantzun.dev/reservas/pago/exitoso"
# TILOPAY_CANCEL_URL="https://trp-booking.juantzun.dev/reservas/pago/cancelado"
# TILOPAY_ERROR_URL="https://trp-booking.juantzun.dev/reservas/pago/error"
# TILOPAY_WEBHOOK_URL="https://trp-booking.juantzun.dev/api/payments/tilopay/webhook"
# NEXT_PUBLIC_WHATSAPP_PHONE_E164="+<developer_test_whatsapp_business_app_e164>"
# WEB_PUSH_VAPID_PUBLIC_KEY="<developer_test_public_vapid_key>"
# WEB_PUSH_VAPID_PRIVATE_KEY="<developer_test_private_vapid_key>"
# WEB_PUSH_SUBJECT="mailto:<owner-controlled-contact>"
# ZOHO_MAIL_WEBHOOK_ENCRYPTION_KEY="<developer_test_32_random_bytes_base64>"
# ZOHO_MAIL_WEBHOOK_BOOTSTRAP_TOKEN="<temporary_bootstrap_token_until_registered>"

# Future production values:
# TRP_ENVIRONMENT="production"
# EMAIL_DELIVERY_MODE="production"
# EMAIL_FROM_ES="Tu Refugio Perfecto <reservas@mail.turefugioperfecto.com>"
# EMAIL_FROM_EN="Tu Refugio Perfecto <reservations@mail.turefugioperfecto.com>"
# EMAIL_REPLY_TO_ES="reservas@turefugioperfecto.com"
# EMAIL_REPLY_TO_EN="reservations@turefugioperfecto.com"
# EMAIL_ADMIN_RECIPIENTS="admin@turefugioperfecto.com"
# EMAIL_PUBLIC_BASE_URL="https://turefugioperfecto.com"
# EMAIL_BRAND_LOGO_URL="https://res.cloudinary.com/juan-tzun-portfolio/image/upload/v1784668172/trp-booking/brand/logo-primary.png"
# EMAIL_TEST_RECIPIENT=""
# TILOPAY_ENVIRONMENT="production"
# NEXT_PUBLIC_WHATSAPP_PHONE_E164="+<trp_official_whatsapp_business_app_e164>"
# WEB_PUSH_* production values are intentionally deferred to Phase 13 and must
# use company-owned key material.
# ZOHO_MAIL_WEBHOOK_* production values are intentionally deferred to Phase 13
# and must use company-owned key material.

# Airbnb iCal / Vercel Cron
#
# Phase 7.5 uses CRON_SECRET to protect /api/cron/sync-airbnb-calendars
# and Phase 8.5.1 uses it to protect /api/cron/expire-pending-reservation-holds.
#
# Generate a strong value locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep this value server-side only. Do not expose it through NEXT_PUBLIC variables.
CRON_SECRET="CHANGE_ME_GENERATE_RANDOM_CRON_SECRET"

# External-calendar secret encryption
#
# Required by Final-B for authenticated encryption of private Airbnb import URLs and
# recoverable TRP outbound tokens. Generate exactly 32 random bytes as Base64 with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT: Local and stable Test intentionally share the same developer-owned database,
# so they must use the SAME EXTERNAL_CALENDAR_ENCRYPTION_KEY. Future Production must use
# a different company-owned key. Changing the key without re-encrypting persisted secrets
# makes those ciphertexts intentionally undecryptable. Keep this value server-side only.
EXTERNAL_CALENDAR_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_RANDOM_BYTES_BASE64"
